<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>SunTime</ApplicationTitle>
    <ApplicationId>com.suntime</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>SunTime</ApplicationPublisher>
    <Description>Sun position visualizer with 24-hour analog clock.</Description>

    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>


  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <Assets Remove="Assets/pilot_watch.jpg" />
    <Assets Remove="Assets/black-cat-with-white-background-black-silhouette_1284217-112.jpg" />
    <None Remove="Assets/pilot_watch.jpg" />
    <None Remove="Assets/black-cat-with-white-background-black-silhouette_1284217-112.jpg" />
    <AndroidResource Remove="Assets/pilot_watch.jpg" />
    <AndroidResource Remove="Assets/black-cat-with-white-background-black-silhouette_1284217-112.jpg" />
    <Content Remove="Assets/pilot_watch.jpg" />
    <Content Remove="Assets/black-cat-with-white-background-black-silhouette_1284217-112.jpg" />
  </ItemGroup>

</Project>
