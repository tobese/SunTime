<Page x:Class="SunTime.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark"
      Background="#121220">

  <Page.Resources>
    <!-- Make the ToggleSwitch off-state track visible on a dark background -->
    <SolidColorBrush x:Key="ToggleSwitchFillOff"              Color="#4A4A5E"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver"   Color="#5A5A6E"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed"       Color="#6A6A7E"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff"          Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#EEEEEE"/>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel HorizontalAlignment="Center"
                MaxWidth="480"
                Margin="16,16,16,32"
                Spacing="12">

      <!-- Title row — HyperlinkButton has a transparent hit area that works in WASM -->
      <Grid Margin="0,0,0,8">
        <HyperlinkButton x:Name="BackButton"
                         Content="← Back"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Foreground="#EEEEEE"
                         FontSize="15"
                         Click="BackButton_Click" />
        <TextBlock Text="Settings"
                   Foreground="#EEEEEE"
                   FontSize="17"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- ── Appearance card ─────────────────────────────── -->
      <TextBlock Text="APPEARANCE"
                 Foreground="#555566"
                 FontSize="11"
                 FontWeight="SemiBold"
                 Margin="4,0,0,0" />

      <Border Background="#1C1C2E"
              CornerRadius="14"
              Padding="20,8">
        <StackPanel Spacing="0">

          <!-- Sky background -->
          <Grid MinHeight="64">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Dynamic sky background"
                         Foreground="#EEEEEE"
                         FontSize="14" />
              <TextBlock Text="Background shifts from deep night through twilight to daytime blue."
                         Foreground="#777788"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="ShowSkyBackgroundToggle"
                          Grid.Column="1"
                          OnContent="" OffContent=""
                          IsOn="True"
                          VerticalAlignment="Center"
                          Toggled="ShowSkyBackgroundToggle_Toggled" />
          </Grid>

          <Rectangle Height="1" Fill="#2A2A3A" Margin="-20,0"/>

          <!-- Season ring -->
          <Grid MinHeight="64">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Season ring"
                           Foreground="#EEEEEE"
                           FontSize="14"
                           VerticalAlignment="Center" />
                <TextBlock Text="ⓘ"
                           Foreground="#777788"
                           FontSize="13"
                           VerticalAlignment="Center"
                           ToolTipService.ToolTip="One arc on the inner ring coloured by the daylight window of each solar calendar date at your location. Gold = summer solstice (longest day, widest arc). Blue = winter solstice (shortest day, narrowest, drawn on top). Darker green = where both equinoxes overlap. Spring green = daylight hours unique to the spring equinox. Amber = unique to the autumn equinox. Arc position = time of day; arc width = day length." />
              </StackPanel>
              <TextBlock Text="Sunrise-to-sunset arcs for solstices and equinoxes."
                         Foreground="#777788"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="ShowSeasonRingToggle"
                          Grid.Column="1"
                          OnContent="" OffContent=""
                          IsOn="True"
                          VerticalAlignment="Center"
                          Toggled="ShowSeasonRingToggle_Toggled" />
          </Grid>

          <Rectangle Height="1" Fill="#2A2A3A" Margin="-20,0"/>

          <!-- Moon -->
          <Grid MinHeight="64">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Moon phase"
                         Foreground="#EEEEEE"
                         FontSize="14" />
              <TextBlock Text="Moon icon with current phase rendered on the dial ring."
                         Foreground="#777788"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="ShowMoonToggle"
                          Grid.Column="1"
                          OnContent="" OffContent=""
                          IsOn="True"
                          VerticalAlignment="Center"
                          Toggled="ShowMoonToggle_Toggled" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ── Clock card ──────────────────────────────────── -->
      <TextBlock Text="CLOCK"
                 Foreground="#555566"
                 FontSize="11"
                 FontWeight="SemiBold"
                 Margin="4,4,0,0" />

      <Border Background="#1C1C2E"
              CornerRadius="14"
              Padding="20,8">
        <StackPanel Spacing="0">

          <!-- DST -->
          <Grid MinHeight="64">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Adjust for daylight saving time"
                         Foreground="#EEEEEE"
                         FontSize="14" />
              <TextBlock Text="Shifts solar noon to match your clock during DST."
                         Foreground="#777788"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="DstToggle"
                          Grid.Column="1"
                          OnContent="" OffContent=""
                          IsOn="True"
                          VerticalAlignment="Center"
                          Toggled="DstToggle_Toggled" />
          </Grid>

          <Rectangle Height="1" Fill="#2A2A3A" Margin="-20,0"/>

          <!-- Noon at top -->
          <Grid MinHeight="64">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Solar noon at top"
                         Foreground="#EEEEEE"
                         FontSize="14" />
              <TextBlock Text="Tilt the clock so solar noon always sits at 12 o'clock."
                         Foreground="#777788"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="NoonAtTopToggle"
                          Grid.Column="1"
                          OnContent="" OffContent=""
                          IsOn="False"
                          VerticalAlignment="Center"
                          Toggled="NoonAtTopToggle_Toggled" />
          </Grid>

          <Rectangle Height="1" Fill="#2A2A3A" Margin="-20,0"/>

          <!-- Durations -->
          <Grid MinHeight="64">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Show durations"
                         Foreground="#EEEEEE"
                         FontSize="14" />
              <TextBlock Text="Daylight and nighttime length inside the ring."
                         Foreground="#777788"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="ShowDurationsToggle"
                          Grid.Column="1"
                          OnContent="" OffContent=""
                          IsOn="False"
                          VerticalAlignment="Center"
                          Toggled="ShowDurationsToggle_Toggled" />
          </Grid>

          <Rectangle Height="1" Fill="#2A2A3A" Margin="-20,0"/>

          <!-- Apex time -->
          <Grid MinHeight="64">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Apex time"
                         Foreground="#EEEEEE"
                         FontSize="14" />
              <TextBlock Text="Solar noon time label. Marker dot is always visible."
                         Foreground="#777788"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="ShowApexTimeToggle"
                          Grid.Column="1"
                          OnContent="" OffContent=""
                          IsOn="False"
                          VerticalAlignment="Center"
                          Toggled="ShowApexTimeToggle_Toggled" />
          </Grid>

          <Rectangle Height="1" Fill="#2A2A3A" Margin="-20,0"/>

          <!-- Week diffs -->
          <Grid MinHeight="64">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Week diffs"
                         Foreground="#EEEEEE"
                         FontSize="14" />
              <TextBlock Text="Hatched arc sectors and weekly ±min gain/loss on rise and set."
                         Foreground="#777788"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="ShowWeekDiffsToggle"
                          Grid.Column="1"
                          OnContent="" OffContent=""
                          IsOn="False"
                          VerticalAlignment="Center"
                          Toggled="ShowWeekDiffsToggle_Toggled" />
          </Grid>

          <Rectangle Height="1" Fill="#2A2A3A" Margin="-20,0"/>

          <!-- Sun angle -->
          <Grid MinHeight="64">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Sun angle"
                         Foreground="#EEEEEE"
                         FontSize="14" />
              <TextBlock Text="Current solar elevation near the sun icon."
                         Foreground="#777788"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="ShowSunAngleToggle"
                          Grid.Column="1"
                          OnContent="" OffContent=""
                          IsOn="False"
                          VerticalAlignment="Center"
                          Toggled="ShowSunAngleToggle_Toggled" />
          </Grid>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</Page>
