<Page x:Class="SunTime.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:SunTime.Controls"
      RequestedTheme="Dark"
      Background="#121220">

  <Grid>

    <!-- Full-screen dial -->
    <controls:SunDial x:Name="Dial"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

    <!-- Overflow menu — top-right, Android-standard three-dot pattern -->
    <Button x:Name="OverflowButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,8,4,0"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="24"
            Width="48"
            Height="48">
      <Button.Flyout>
        <MenuFlyout Placement="BottomEdgeAlignedRight">
          <MenuFlyoutItem Text="Settings"
                          Click="SettingsMenuItem_Click" />
        </MenuFlyout>
      </Button.Flyout>
      <TextBlock Text="⋮"
                 FontSize="22"
                 Foreground="#EEEEEE"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />
    </Button>

    <!-- Debug bar — top-left overlay (DEBUG builds only) -->
    <StackPanel x:Name="DebugBar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Orientation="Vertical"
                Spacing="2"
                Margin="8,8,0,0"
                Padding="8,6,8,6"
                Background="#BB121220">

      <!-- Time row -->
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="🕐" FontSize="12" VerticalAlignment="Center" Foreground="#FFCC00"/>
        <Slider x:Name="TimeSlider"
                Minimum="0" Maximum="1439" StepFrequency="1"
                VerticalAlignment="Center"
                MinWidth="150" />
        <TextBlock x:Name="DebugTimeText"
                   Width="40"
                   Foreground="#FFCC00"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextAlignment="Center" />
        <Button x:Name="DebugResetBtn"
                Content="Now"
                Padding="6,2"
                FontSize="12"
                VerticalAlignment="Center" />
        <Button x:Name="DebugEqBtn"
                Content="EQ"
                Padding="6,2"
                FontSize="12"
                VerticalAlignment="Center" />
      </StackPanel>

      <!-- Date row -->
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="📅" FontSize="12" Width="22" VerticalAlignment="Center" Foreground="#AAFFAA"/>
        <Slider x:Name="DateSlider"
                Minimum="1" Maximum="365" StepFrequency="1"
                VerticalAlignment="Center"
                MinWidth="150" />
        <TextBlock x:Name="DebugDateText"
                   Width="52"
                   Foreground="#AAFFAA"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextAlignment="Right" />
      </StackPanel>

      <!-- Lat row -->
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="lat" FontSize="12" Width="22" VerticalAlignment="Center" Foreground="#88CCFF"/>
        <Slider x:Name="LatSlider"
                Minimum="-90" Maximum="90" StepFrequency="0.5"
                VerticalAlignment="Center"
                MinWidth="150" />
        <TextBlock x:Name="DebugLatText"
                   Width="52"
                   Foreground="#88CCFF"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextAlignment="Right" />
      </StackPanel>

      <!-- Lon row -->
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="lon" FontSize="12" Width="22" VerticalAlignment="Center" Foreground="#88CCFF"/>
        <Slider x:Name="LonSlider"
                Minimum="-180" Maximum="180" StepFrequency="0.5"
                VerticalAlignment="Center"
                MinWidth="150" />
        <TextBlock x:Name="DebugLonText"
                   Width="52"
                   Foreground="#88CCFF"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextAlignment="Right" />
      </StackPanel>

    </StackPanel>

  </Grid>

</Page>
