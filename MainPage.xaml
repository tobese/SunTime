<Page x:Class="SunTime.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:SunTime.Controls"
      RequestedTheme="Dark"
      Background="#121220">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText"
                 Text="Locating…"
                 Foreground="#AAAAAA"
                 FontSize="14"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

      <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,4"
              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
        <ToggleSwitch x:Name="DstToggle"
                      OnContent="DST"
                      OffContent="DST"
                      IsOn="True"
                      Foreground="#CCCCCC"
                      Margin="0" />
      </Border>
    </Grid>

    <controls:SunDial x:Name="Dial"
                      Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
  </Grid>

</Page>
