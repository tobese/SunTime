<Page x:Class="SunTime.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:SunTime.Controls"
      RequestedTheme="Dark"
      Background="#121220">

  <Grid>

    <!-- Full-screen dial -->
    <controls:SunDial x:Name="Dial"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

    <!-- Settings button — top-right overlay -->
    <Button x:Name="SettingsButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,14,14,0"
            Background="#33FFFFFF"
            BorderThickness="0"
            CornerRadius="20"
            Padding="10,6"
            Click="SettingsButton_Click">
      <TextBlock Text="⚙"
                 FontSize="17"
                 Foreground="#DDDDDD" />
    </Button>

    <!-- Debug bar — top overlay (DEBUG builds only, collapsed by default) -->
    <StackPanel x:Name="DebugBar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Orientation="Horizontal"
                Spacing="8"
                Margin="12,14,0,0"
                Background="#99121220">
      <Slider x:Name="TimeSlider"
              Minimum="0" Maximum="1439" StepFrequency="1"
              VerticalAlignment="Center"
              MinWidth="160" />
      <TextBlock x:Name="DebugTimeText"
                 Width="48"
                 Foreground="#FFCC00"
                 FontSize="13"
                 VerticalAlignment="Center"
                 TextAlignment="Center" />
      <Button x:Name="DebugResetBtn"
              Content="✕"
              Padding="6,2"
              FontSize="13" />
    </StackPanel>

  </Grid>

</Page>
