{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SunTime Android (Baklava-M, Fast)",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "run",
                "--no-restore",
                "--project",
                "${workspaceFolder}/SunTime.csproj",
                "-f",
                "net10.0-android",
                "-p:AndroidAdbTarget=Baklava-M"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "android: verify Baklava-M"
        },
        {
            "name": "SunTime Android (Baklava-M, No Build)",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "run",
                "--no-restore",
                "--no-build",
                "--project",
                "${workspaceFolder}/SunTime.csproj",
                "-f",
                "net10.0-android",
                "-p:AndroidAdbTarget=Baklava-M"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "android: verify Baklava-M"
        },
        {
            "name": "SunTime WebAssembly",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/SunTime.csproj",
                "-f",
                "net10.0-browserwasm"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}