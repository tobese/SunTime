# --- Build stage ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Install dependencies required by emscripten/WASM native compilation
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*

# Install WASM workload
RUN dotnet workload install wasm-tools

# Copy solution and project files for restore
COPY Directory.Build.props Directory.Build.targets Directory.Packages.props global.json ./
COPY SunTime.csproj ./
RUN dotnet restore SunTime.csproj

# Copy everything and publish
COPY . .
RUN dotnet publish SunTime.csproj -f net10.0-browserwasm -c Release -o /app/publish

# --- Runtime stage ---
FROM nginx:alpine AS final
COPY --from=build /app/publish/wwwroot /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf
EXPOSE 80
